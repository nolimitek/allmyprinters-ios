<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Druck-Meldungen über Apple (APNs); TestFlight/App Store = production -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Schlüssel der Druck-Meldungen teilen mit der Notification Service Extension -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.allmyprinters.shared</string>
	</array>
</dict>
</plist>
